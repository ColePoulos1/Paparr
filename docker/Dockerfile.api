FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY Directory.Build.props global.json ./
COPY src/Paparr.API/Paparr.API.csproj src/Paparr.API/
RUN dotnet restore src/Paparr.API/Paparr.API.csproj
COPY src/Paparr.API/ src/Paparr.API/
RUN dotnet publish src/Paparr.API/Paparr.API.csproj -c Release --no-restore -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_HTTP_PORTS=8080
ENV ASPNETCORE_ENVIRONMENT=Production
RUN mkdir -p /data/keys && chown -R $APP_UID:$APP_UID /data && chmod 700 /data/keys
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "Paparr.API.dll"]
