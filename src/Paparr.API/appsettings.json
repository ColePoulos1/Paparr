{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Authentication": {
    "Enabled": true,
    "SecureCookies": false,
    "KeysPath": ".paparr/keys"
  },
  "IngestPath": "./ingest",
  "LibraryPath": "./library",
  "PollingIntervalSeconds": 10,
  "FileStableSeconds": 5,
  "MaxFileSizeMb": 100,
  "MaxAttempts": 3,
  "LeaseMinutes": 5,
  "DeleteSourceAfterImport": false,
  "WorkerEnabled": true,
  "MetadataProvidersEnabled": true
}
